# Cygnus Environment Configuration Template
# Copy this file to .env and fill in required values.
# NEVER commit a secret key, seed phrase, or .env file to version control.

# Stellar network to deploy against. Testnet only for development.
# Allowed values: testnet, local, standalone
NETWORK=testnet

# Network passphrase for Stellar Testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Stellar RPC URL for Testnet
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# Name of the local CLI identity (keys stored securely in ~/.stellar/identity/)
# Create and fund a deployer identity with:
#   stellar keys generate cygnus-deployer --network testnet --fund
SOURCE=cygnus-deployer

# Deployment output path for recording contract addresses
OUT=deployments/testnet.json

# Deployed programme contract address on Testnet (deployment truth)
PROGRAMME_CONTRACT_ID=CBN6MNOWZISG6EXVCUQSGKASFSIBVDBZSVASI6FZYBLBMLHMQWL6SAL7
